# --- Digital Ocean Spaces ---
# Host del endpoint S3 (sin https://)
SPACES_ENDPOINT=sfo3.digitaloceanspaces.com
SPACES_CDN_ENDPOINT=sfo3.cdn.digitaloceanspaces.com
SPACES_REGION=sfo3
BUCKET_NAME=ninjacdn
SPACES_KEY=your-spaces-key
SPACES_SECRET_KEY=your-spaces-secret-key

# Poner en true una sola vez para aplicar la politica CORS del bucket.
# Dejarlo activado hace una escritura de configuracion en cada arranque.
CONFIGURE_BUCKET_CORS=false

# --- Servidor ---
PORT=5000
NODE_ENV=production

# Numero de proxies inversos delante de la app (nginx/Cloudflare = 1).
# No usar un valor alto: se usa para resolver la IP real del rate limiter.
TRUST_PROXY=1

# --- Autenticacion del panel ---
# Minimo 12 caracteres en produccion.
ADMIN_PASSWORD=your-secure-password
ADMIN2_PASSWORD=your-second-admin-password

# Obligatorio en produccion, minimo 32 caracteres.
# Generar con: openssl rand -hex 32
SESSION_SECRET=
